# Optional: enables Gemini narration of deterministic scores.
# Without a key, Sankofa serves rule-based narration (labelled as such).
GEMINI_API_KEY=

# Optional: enables Khaya AI translation of the narration into Ghanaian
# languages (twi, ewe, gaa, fat, dag, gur, kus). Without a key, narration
# stays in English.
KHAYA_API_KEY=
